	urldate = {2026-09-25},
	journal = {Universal Access in the Information Society},
	author = {Zubair, Misbahu S. and Brown, David J. and Hughes-Roberts, Thomas and Bates, Matthew},
	month = jun,
	year = {2023},
	pages = {277--296},
	file = {Texto completo:files/25/Zubair et al. - 2023 - Designing accessible visual programming tools for children with autism spectrum condition.pdf:application/pdf},
